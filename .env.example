# 应用
APP_NAME=景区导览服务AI数字人
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173

# 数据库
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scenic_ai_guide
POSTGRES_USER=scenic_user
POSTGRES_PASSWORD=scenic_password
DATABASE_URL=postgresql+psycopg://scenic_user:scenic_password@postgres:5432/scenic_ai_guide

# 向量库
CHROMA_PERSIST_DIR=/app/data/vector_store/chroma

# LLM，可在工程师模式后续任务中接入
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus

# 语音，可选
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
TTS_PROVIDER=edge
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 地图，可选
AMAP_API_KEY=
